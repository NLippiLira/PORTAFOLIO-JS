<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Sobre mí | Nicolás Lippi</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/public.css">
</head>

<body>

  <!-- HERO -->
  <section class="bio-hero d-flex align-items-center">
    <div class="container text-center fade-in">
      <h1 class="bio-title">Sobre mí</h1>
      <p class="bio-subtitle">
        Desarrollo soluciones modernas, escalables y orientadas a resultados.
      </p>
    </div>
  </section>

  <!-- CONTENIDO -->
  <section class="bio-content-section py-5">
    <div class="container">

      <div class="bio-card mx-auto shadow-lg rounded-4 p-4 p-md-5 fade-in-up">

        <% if (bio) { %>

        <div class="row align-items-center g-5">

          <!-- IMAGEN -->
          <div class="col-lg-4 text-center">
            <img src="/img/fotoparaCV.jpeg"
                 alt="Nicolás Lippi"
                 class="bio-image img-fluid">
          </div>

          <!-- TEXTO -->
          <div class="col-lg-8">
            <h2 class="bio-heading mb-4"><%= bio.title %></h2>

            <p class="bio-text">
              <%= bio.content %>
            </p>
          </div>

        </div>

        <% } else { %>

        <div class="text-center text-muted py-5">
          <h4>Biografía no disponible</h4>
          <p>Pronto agregaré más información profesional.</p>
        </div>

        <% } %>

      </div>

    </div>
  </section>
<a href="/home" class="home-button">
  <i class="bi bi-house-fill"></i>
</a>
</body>
</html>