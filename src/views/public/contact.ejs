<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Contacto | Nicolás Lippi</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <!-- CSS Global -->
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/public.css">
</head>

<body>

<!-- HERO -->
<section class="contact-hero d-flex align-items-center">
  <div class="container text-center">
    <h1 class="contact-title fade-in">Contacto</h1>
    <p class="contact-subtitle fade-in">
      ¿Tienes una propuesta, colaboración o proyecto en mente?
    </p>
  </div>
</section>

<!-- FORM -->
<section class="contact-section py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-6">

        <div class="glass-card p-5 fade-item">

          <!-- ALERTAS VISUALES -->
          <% if (error && error.length > 0) { %>
            <div class="alert alert-danger rounded-3">
              <i class="bi bi-exclamation-triangle-fill me-2"></i>
              <%= error[0] %>
            </div>
          <% } %>

          <form method="POST" action="/contacto">

            <div class="mb-4">
              <label class="form-label">Nombre</label>
              <input type="text"
                     name="name"
                     class="form-control form-control-lg rounded-3"
                     required>
            </div>

            <div class="mb-4">
              <label class="form-label">Email</label>
              <input type="email"
                     name="email"
                     class="form-control form-control-lg rounded-3"
                     required>
            </div>

            <div class="mb-4">
              <label class="form-label">Mensaje</label>
              <textarea name="message"
                        rows="5"
                        class="form-control form-control-lg rounded-3"
                        required></textarea>
            </div>

            <button class="btn btn-primary w-100 py-2 rounded-3">
              <i class="bi bi-send-fill me-2"></i>
              Enviar mensaje
            </button>

          </form>

        </div>

      </div>
    </div>
  </div>
</section>

<!-- BOTÓN VOLVER HOME -->
<a href="/home" class="home-button">
  <i class="bi bi-house-fill"></i>
</a>

<!-- MODAL ÉXITO -->
<div class="modal fade" id="successModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 shadow">
      <div class="modal-body text-center p-5">
        <i class="bi bi-check-circle-fill text-success"
           style="font-size: 3rem;"></i>

        <h4 class="mt-3 mb-2">Mensaje enviado</h4>
        <p class="text-muted">
          Se envió el mensaje correctamente.
        </p>

        <button type="button"
                class="btn btn-primary mt-3 rounded-3"
                data-bs-dismiss="modal">
          Aceptar
        </button>
      </div>
    </div>
  </div>
</div>

<!-- FLAG SEGURA PARA MOSTRAR MODAL -->
<div id="contactSuccess"
     data-success="<%= success && success.length > 0 ? 'true' : 'false' %>">
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Scripts personalizados -->
<script>
  document.addEventListener("DOMContentLoaded", function () {

    // Animación escalonada
    document.querySelectorAll('.fade-item').forEach((el, index) => {
      el.style.animationDelay = (index * 0.1) + 's';
    });

    // Mostrar modal si hubo éxito
    const successFlag = document
      .getElementById("contactSuccess")
      .dataset.success;

    if (successFlag === "true") {
      const successModal = new bootstrap.Modal(
        document.getElementById("successModal")
      );
      successModal.show();
    }

  });
</script>

</body>
</html>