<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Admin | Portafolio NL</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

  <!-- CSS Global -->
  <link rel="stylesheet" href="/css/styles.css">

  <!-- CSS Admin -->
  <link rel="stylesheet" href="/css/admin.css">
</head>

<body>
<div class="admin-section">

  <div class="admin-header mb-4">
    <h3 class="admin-title">Gestión de Proyectos</h3>
    <p class="admin-subtitle">Administra tus proyectos personales.</p>
  </div>

  <div class="card admin-card shadow-sm mb-4">
    <div class="card-body">
      <form method="POST" action="/admin/proyectos">
        <div class="row g-3">
          <div class="col-md-3">
            <label class="form-label">Título</label>
            <input name="title" class="form-control" required>
          </div>

          <div class="col-md-4">
            <label class="form-label">Descripción</label>
            <textarea name="description" class="form-control" rows="2" required></textarea>
          </div>

          <div class="col-md-2">
            <label class="form-label">GitHub</label>
            <input name="github_url" class="form-control">
          </div>

          <div class="col-md-2">
            <label class="form-label">Demo</label>
            <input name="demo_url" class="form-control">
          </div>

          <div class="col-md-1 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">
              Agregar
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <div class="card admin-card shadow-sm">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Título</th>
              <th>Descripción</th>
              <th>GitHub</th>
              <th>Demo</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% projects.forEach(p => { %>
              <tr>
                <td><strong><%= p.title %></strong></td>
                <td><%= p.description %></td>
                <td>
                  <% if (p.github_url) { %>
                    <a href="<%= p.github_url %>" target="_blank" class="btn btn-sm btn-outline-dark">GitHub</a>
                  <% } else { %> - <% } %>
                </td>
                <td>
                  <% if (p.demo_url) { %>
                    <a href="<%= p.demo_url %>" target="_blank" class="btn btn-sm btn-outline-dark">Demo</a>
                  <% } else { %> - <% } %>
                </td>
                <td class="text-end">
                  <form method="POST" action="/admin/proyectos/<%= p.id %>/delete">
                    <button class="btn btn-sm btn-outline-danger">
                      Eliminar
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>
<a href="/admin/dashboard" class="admin-back-button">
  <i class="bi bi-speedometer2"></i>
</a>
</body>
</html>