
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Admin | Portafolio NL</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

  <!-- CSS Global -->
  <link rel="stylesheet" href="/css/styles.css">

  <!-- CSS Admin -->
  <link rel="stylesheet" href="/css/admin.css">
</head>



<div class="admin-section">

  <div class="admin-header d-flex justify-content-between align-items-center">
    <h4>
      <%= bio ? 'Editar Biografía' : 'Nueva Biografía' %>
    </h4>
  </div>

  <div class="card admin-card">
    <div class="card-body">

      <form method="POST"
            action="<%= bio ? '/admin/biografia/editar/' + bio.id : '/admin/biografia/nueva' %>">

        <div class="mb-4">
          <label class="form-label">Título</label>
          <input type="text"
                 name="titulo"
                 class="form-control"
                 required
                 value="<%= bio ? bio.titulo : '' %>">
        </div>

        <div class="mb-4">
          <label class="form-label">Contenido</label>
          <textarea name="contenido"
                    class="form-control"
                    rows="6"
                    required><%= bio ? bio.contenido : '' %></textarea>
        </div>

        <div class="d-flex justify-content-between">
          <a href="/admin/biografia" class="btn btn-outline-secondary">
            Cancelar
          </a>

          <button class="btn btn-primary">
            Guardar
          </button>
        </div>

      </form>

    </div>
  </div>

</div>
