<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Admin | Biografías</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>

<body>

<div class="container py-5">

  <h2 class="fw-bold mb-4">Gestión de Biografías</h2>

  <!-- ============================= -->
  <!-- FORMULARIO CREAR -->
  <!-- ============================= -->
  <div class="card shadow-sm border-0 rounded-4 mb-5">
    <div class="card-body">
      <h5 class="mb-3">Nueva Biografía</h5>

      <form action="/admin/biografia" method="POST">

        <div class="mb-3">
          <label class="form-label">Título</label>
          <input type="text" name="title" class="form-control" required>
        </div>

        <div class="mb-3">
          <label class="form-label">Contenido</label>
          <textarea name="content" rows="4" class="form-control" required></textarea>
        </div>

        <button class="btn btn-primary rounded-3 px-4">
          Guardar
        </button>

      </form>
    </div>
  </div>


  <!-- ============================= -->
  <!-- LISTADO -->
  <!-- ============================= -->
  <div class="card shadow-sm border-0 rounded-4">
    <div class="card-body">

      <% if (biografias && biografias.length > 0) { %>

        <table class="table align-middle">
          <thead>
            <tr>
              <th>ID</th>
              <th>Título</th>
              <th>Contenido</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody>

            <% biografias.forEach(bio => { %>

              <tr>
                <td><%= bio.id %></td>

                <!-- EDIT INLINE -->
                <td colspan="3">

                  <form action="/admin/biografia/update/<%= bio.id %>" method="POST">

                    <div class="row g-2 align-items-center">

                      <div class="col-md-3">
                        <input type="text"
                               name="title"
                               value="<%= bio.titulo %>"
                               class="form-control">
                      </div>

                      <div class="col-md-5">
                        <input type="text"
                               name="content"
                               value="<%= bio.contenido %>"
                               class="form-control">
                      </div>

                      <div class="col-md-4 text-end">

                        <button class="btn btn-sm btn-outline-success me-2">
                          Actualizar
                        </button>

                  </form>

                        <form action="/admin/biografia/delete/<%= bio.id %>"
                              method="POST"
                              style="display:inline;">
                          <button class="btn btn-sm btn-outline-danger">
                            Eliminar
                          </button>
                        </form>

                      </div>
                    </div>

                </td>
              </tr>

            <% }) %>

          </tbody>
        </table>

      <% } else { %>
        <p class="text-muted">No hay biografías registradas.</p>
      <% } %>

    </div>
  </div>

</div>

</body>
</html>