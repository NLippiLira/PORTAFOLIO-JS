<div class="container mt-4">
  <h2>Gestión de Bibliografía</h2>

  <form method="POST" action="/admin/bibliografia" class="mb-4">
    <div class="row g-2">
      <div class="col">
        <input name="title" class="form-control" placeholder="Título" required>
      </div>
      <div class="col">
        <input name="author" class="form-control" placeholder="Autor">
      </div>
      <div class="col">
        <input name="year" class="form-control" placeholder="Año">
      </div>
      <div class="col">
        <input name="url" class="form-control" placeholder="URL">
      </div>
      <div class="col">
        <button class="btn btn-primary w-100">Agregar</button>
      </div>
    </div>
  </form>

  <hr>

  <ul class="list-group">
    <% items.forEach(item => { %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <div>
          <strong><%= item.title %></strong>
          <% if (item.author) { %> - <%= item.author %> <% } %>
          <% if (item.year) { %> (<%= item.year %>) <% } %>
          <% if (item.url) { %>
            <a href="<%= item.url %>" target="_blank" class="ms-2">Ver</a>
          <% } %>
        </div>

        <form method="POST" action="/admin/bibliografia/<%= item.id %>/delete">
          <button class="btn btn-sm btn-danger">Eliminar</button>
        </form>
      </li>
    <% }) %>
  </ul>
</div>
