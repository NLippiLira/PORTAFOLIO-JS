
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Admin | Portafolio NL</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

  <!-- CSS Global -->
  <link rel="stylesheet" href="/css/styles.css">

  <!-- CSS Admin -->
  <link rel="stylesheet" href="/css/admin.css">
</head>



<div class="admin-section">

  <div class="admin-header d-flex justify-content-between align-items-center mb-4">
    <div>
      <h3 class="admin-title">Gestión de Bibliografía</h3>
      <p class="admin-subtitle">Administra libros, artículos y referencias.</p>
    </div>
  </div>

  <div class="card admin-card shadow-sm mb-4">
    <div class="card-body">
      <form method="POST" action="/admin/bibliografia">
        <div class="row g-3">
          <div class="col-md-3">
            <label class="form-label">Título</label>
            <input name="title" class="form-control" required>
          </div>

          <div class="col-md-3">
            <label class="form-label">Autor</label>
            <input name="author" class="form-control">
          </div>

          <div class="col-md-2">
            <label class="form-label">Año</label>
            <input name="year" class="form-control">
          </div>

          <div class="col-md-3">
            <label class="form-label">URL</label>
            <input name="url" class="form-control">
          </div>

          <div class="col-md-1 d-flex align-items-end">
            <button class="btn btn-primary w-100">Agregar</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <div class="card admin-card shadow-sm">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Título</th>
              <th>Autor</th>
              <th>Año</th>
              <th>Enlace</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(item => { %>
              <tr>
                <td><strong><%= item.title %></strong></td>
                <td><%= item.author || '-' %></td>
                <td><%= item.year || '-' %></td>
                <td>
                  <% if (item.url) { %>
                    <a href="<%= item.url %>" target="_blank" class="btn btn-sm btn-outline-dark">
                      Ver
                    </a>
                  <% } else { %>
                    -
                  <% } %>
                </td>
                <td class="text-end">
                  <form method="POST" action="/admin/bibliografia/<%= item.id %>/delete">
                    <button class="btn btn-sm btn-outline-danger">
                      Eliminar
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>
